{
  "display_information": {
    "name": "OpenBridge",
    "description": "Remote control for coding agents via Slack",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "OpenBridge",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/project",
        "description": "Manage project connections and settings",
        "usage_hint": "connect /path | list | disconnect | backend claude",
        "should_escape": false
      },
      {
        "command": "/settings",
        "description": "View or change global bridge settings",
        "usage_hint": "root /path",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:history",
        "channels:read",
        "channels:manage",
        "channels:join",
        "groups:history",
        "groups:read",
        "groups:write",
        "files:read",
        "files:write",
        "commands",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
