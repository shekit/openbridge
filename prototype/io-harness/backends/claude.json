{
  "name": "claude",
  "command": "/Users/abhishek/.nvm/versions/node/v22.18.0/bin/claude",
  "cwd": "{project}",
  "unsetEnv": ["CLAUDECODE"],
  "fallbackOneShot": {
    "command": "/Users/abhishek/.nvm/versions/node/v22.18.0/bin/claude",
    "parser": "claude-stream-json",
    "cwd": "{project}",
    "startArgs": [
      "-p",
      "--verbose",
      "--output-format",
      "stream-json",
      "--input-format",
      "text",
      "{prompt}"
    ],
    "resumeArgs": [
      "-p",
      "--verbose",
      "--output-format",
      "stream-json",
      "--input-format",
      "text",
      "-r",
      "{session_id}",
      "{prompt}"
    ]
  }
}
