{
  "name": "full-io-matrix",
  "description": "Deterministic I/O tests for native permission handling and session continuity.",
  "cases": [
    {
      "id": "claude_permission_denial_bash_write",
      "scenario": "claude-permission-text-option",
      "backends": ["claude"],
      "assertions": {
        "contains": [
          "PERMISSION_DENIAL",
          "CLAUDE_TEXT_OPTION_WORKED"
        ]
      }
    },
    {
      "id": "claude_permission_denial_edit",
      "scenario": "claude-edit-denial",
      "backends": ["claude"],
      "assertions": {
        "contains": [
          "PERMISSION_DENIAL",
          "CLAUDE_EDIT_DENIAL_RECOVERED"
        ]
      }
    },
    {
      "id": "codex_sandbox_denial",
      "scenario": "codex-sandbox-denial",
      "backends": ["codex-sandboxed"],
      "assertions": {
        "contains": [
          "SANDBOX_DENIAL",
          "CODEX_SANDBOX_RECOVERY_OK"
        ]
      }
    }
  ]
}
